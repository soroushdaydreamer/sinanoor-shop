{
  "rewrites": [
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/account", "destination": "/frontend/account.html" },
    { "source": "/cart", "destination": "/frontend/cart.html" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" },
    { "source": "/admin/:path*", "destination": "/admin/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
